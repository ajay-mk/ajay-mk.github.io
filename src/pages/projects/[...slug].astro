---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<Base title={project.data.title} description={project.data.description}>
  <article>
    <h1 class="page-title">{project.data.title}</h1>
    <p class="meta">{project.data.tags.join(' · ')}</p>
    {project.data.link && (
      <p><a class="repo" href={project.data.link}>repo / site ↗</a></p>
    )}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .meta { color: var(--accent); font-size: 0.85rem; margin: -20px 0 14px; }
  .repo { display: inline-block; margin-bottom: 24px; font-size: 0.9rem; }
</style>
