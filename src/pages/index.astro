---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import Skills from '../components/Skills.astro';
import Rail from '../components/Rail.astro';
import Figure from '../components/Figure.astro';
import Network from '../components/figures/Network.astro';
import Mpqc from '../components/figures/Mpqc.astro';
import Katal from '../components/figures/Katal.astro';
import CvEntries from '../components/CvEntries.astro';
import PublicationList from '../components/PublicationList.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';
import type { Publication } from '../lib/publications';
import pubsData from '../data/publications.json';

const recent = (pubsData as Publication[]).slice(0, 3);
const cv = await getCollection('cv');
const items = (id: string) => cv.find((e) => e.id === id)?.data.items ?? [];

const work = [
  {
    name: 'SeQuant',
    href: 'https://github.com/ValeevGroup/SeQuant',
    repo: 'ValeevGroup/SeQuant',
    meta: 'C++ · CAS · symbolic tensor algebra',
    desc: "Takes a many-body method from equations to numbers by joining symbolic derivation with numerical evaluation. It automates the slow, error-prone steps in between, which shortens the path from a new idea to results. I developed SeQuant's many-body operator interface and its coupled-cluster capabilities, including alternative ansätze, linear response, and equation-of-motion methods.",
    fig: { art: Network, label: 'Equation to numbers' },
  },
  {
    name: 'Massively Parallel Quantum Chemistry (MPQC)',
    meta: 'C++ · MPI · TiledArray · MADNESS',
    desc: 'A distributed-memory electronic structure package built on the TiledArray tensor framework and the MADNESS parallel runtime. I work on its general-order coupled-cluster code: ground and excited states, linear-response properties, and electric-field perturbations.',
    fig: { art: Mpqc, label: 'Tiles, amplitudes, states' },
  },
  {
    name: 'Katal',
    href: 'https://github.com/ajay-mk/Katal',
    repo: 'ajay-mk/Katal',
    meta: 'C++20 · CUDA · cuTENSOR',
    desc: 'A C++20 einsum library for GPU tensor contractions. You write the equation, and Katal sets up and caches the cuTENSOR plan behind it. Deployed with SeQuant for coupled-cluster evaluations.',
    fig: { art: Katal, label: 'Planned once, cached' },
  },
];

// Repo details for the card footers, fetched at build time. A failed fetch
// just means no footer; it never fails the build.
async function repoInfo(slug: string) {
  const token = process.env.GITHUB_TOKEN;
  try {
    const res = await fetch(`https://api.github.com/repos/${slug}`, {
      headers: token ? { Authorization: `Bearer ${token}` } : {},
    });
    if (!res.ok) return null;
    const r = await res.json();
    return {
      description: r.description as string,
      language: r.language as string,
      stars: r.stargazers_count as number,
      pushed: r.pushed_at as string,
    };
  } catch {
    return null;
  }
}
// GitHub's language colours, for the dot in the card footer.
const langColor: Record<string, string> = { 'C++': '#f34b7d', Python: '#3572A5', Cuda: '#3A4E3A' };
const repos = Object.fromEntries(
  await Promise.all(work.filter((w) => w.repo).map(async (w) => [w.repo, await repoInfo(w.repo!)])),
);


const links = [
  { label: 'GitHub', href: site.socials.github, icon: 'simple-icons:github' },
  { label: 'Google Scholar', href: site.socials.scholar, icon: 'simple-icons:googlescholar' },
  { label: 'LinkedIn', href: site.socials.linkedin, icon: 'simple-icons:linkedin' },
];
---
<Base>
  <header class="hero">
    <div class="lattice" aria-hidden="true"></div>
    <img src="/avatar.jpg" alt={site.name} />
    <div>
      <h1>{site.name}</h1>
      <p class="role">{site.role}</p>
      <p class="motto">learn · build · scale</p>
    </div>
    <nav class="links">
      <a href={`mailto:${site.email}`} aria-label="Email" title="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 7 10 6 10-6" /></svg>
      </a>
      {links.map((l) => <a href={l.href} aria-label={l.label} title={l.label}><Icon name={l.icon} /></a>)}
    </nav>
  </header>

  <section class="section" id="about">
    <h2>About</h2>
    <div class="prose">
      <p>
        I am a PhD candidate in the <a href="https://valeevgroup.github.io" target="_blank" rel="noopener">Valeev
        Research Group</a> at <a href="https://www.vt.edu" target="_blank" rel="noopener">Virginia Tech</a>. My research
        is on coupled-cluster methods and their application to excited states and molecular properties, and my current
        focus is truncated unitary coupled-cluster methods for excited states.
      </p>
      <p>
        I also build the software these methods run on: <a href="https://github.com/ValeevGroup/SeQuant" target="_blank" rel="noopener"><code>SeQuant</code></a>,
        which derives a method's equations symbolically and then drives their numerical evaluation, and <code>MPQC</code>,
        which runs coupled cluster across distributed-memory clusters.
      </p>
      <p>
        Before Virginia Tech, I earned an integrated BS-MS at <a href="https://www.iisertvm.ac.in" target="_blank" rel="noopener">IISER
        Thiruvananthapuram</a>, where I developed empirical interaction potentials for layered materials.
      </p>
    </div>
  </section>

  <section class="section" id="work">
    <h2>Work</h2>
    <div class="cards">
      {work.map((w) => {
        const r = w.repo && repos[w.repo];
        return (
          <article class="card">
            <div class="body">
              <h3>{w.href ? <a href={w.href} target="_blank" rel="noopener">{w.name}</a> : w.name}</h3>
              <div class="meta">{w.meta.split(' · ').map((m) => <span>{m}</span>)}</div>
              <p>{w.desc}</p>
              {r && (
                <p class="repo">
                  <a href={w.href} target="_blank" rel="noopener"><Icon name="simple-icons:github" />{w.repo}</a>
                  {r.language && <span><span class="dot" style={`background:${langColor[r.language] ?? 'var(--text-muted)'}`} />{r.language}</span>}
                  <span>★ {r.stars}</span>
                  <span>updated <time datetime={r.pushed} data-relative>{r.pushed.slice(0, 10)}</time></span>
                </p>
              )}
            </div>
            <Figure label={w.fig.label}><w.fig.art /></Figure>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section" id="experience">
    <h2>Experience</h2>
    <CvEntries items={items('experience')} />
  </section>

  <section class="section" id="publications">
    <h2>Publications</h2>
    <div>
      <PublicationList items={recent} previews />
      <p class="more"><a href="/publications">All publications →</a></p>
    </div>
  </section>

  <section class="section" id="education">
    <h2>Education</h2>
    <CvEntries items={items('education')} />
  </section>

  <section class="section" id="skills">
    <h2>Skills</h2>
    <Skills items={items('skills')} />
  </section>
  <Rail sections={[
    { id: 'about', label: 'About' }, { id: 'work', label: 'Work' }, { id: 'experience', label: 'Experience' },
    { id: 'publications', label: 'Publications' }, { id: 'education', label: 'Education' }, { id: 'skills', label: 'Skills' },
  ]} />
</Base>

<script>
  // Hero spotlight: track the pointer over the hero (mouse and pen only).
  const lattice = document.querySelector<HTMLElement>('.lattice');
  const hero = document.querySelector<HTMLElement>('.hero');
  if (lattice && hero && matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    hero.addEventListener('pointermove', (e) => {
      const r = lattice.getBoundingClientRect();
      lattice.style.setProperty('--mx', `${e.clientX - r.left}px`);
      lattice.style.setProperty('--my', `${e.clientY - r.top}px`);
      lattice.classList.add('lit');
    });
    hero.addEventListener('pointerleave', () => lattice.classList.remove('lit'));
  }

  // Figures animate when a card first scrolls into view, and again on hover.
  const play = (card: HTMLElement) => { card.classList.remove('play'); void card.offsetWidth; card.classList.add('play'); };
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { play(e.target as HTMLElement); io.unobserve(e.target); }
  }, { threshold: 0.6 });
  for (const card of document.querySelectorAll<HTMLElement>('.card')) {
    io.observe(card);
    card.addEventListener('pointerenter', () => play(card));
  }

  // Relative "updated" times, computed in the browser so they stay current between builds.
  const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
  for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-relative]')) {
    const days = Math.round((Date.parse(el.dateTime) - Date.now()) / 86_400_000);
    el.textContent = Math.abs(days) < 30 ? rtf.format(days, 'day')
      : Math.abs(days) < 365 ? rtf.format(Math.round(days / 30), 'month')
      : rtf.format(Math.round(days / 365), 'year');
  }
</script>

<style>
  .hero { position: relative; isolation: isolate; display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; padding: 24px 0 32px; }
  .hero > :not(.lattice) { position: relative; }

  /* index lattice: faint dot grid on the right; dots near the pointer light up in the accent colour */
  .lattice {
    --dot: 1px; --step: 18px;
    position: absolute; z-index: -1; inset: 0 0 0 30%; pointer-events: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 55%), linear-gradient(transparent, #000 20%, #000 80%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 55%), linear-gradient(transparent, #000 20%, #000 80%, transparent);
    -webkit-mask-composite: source-in; mask-composite: intersect;
  }
  .lattice::before, .lattice::after {
    content: ''; position: absolute; inset: 0;
    background-size: var(--step) var(--step); background-position: center;
  }
  .lattice::before {
    background-image: radial-gradient(circle, color-mix(in srgb, var(--text-muted) 40%, transparent) var(--dot), transparent calc(var(--dot) + 0.4px));
  }
  .lattice::after {
    background-image: radial-gradient(circle, var(--accent) calc(var(--dot) + 0.3px), transparent calc(var(--dot) + 0.7px));
    -webkit-mask-image: radial-gradient(120px circle at var(--mx, 50%) var(--my, 50%), #000, transparent);
    mask-image: radial-gradient(120px circle at var(--mx, 50%) var(--my, 50%), #000, transparent);
    opacity: 0; transition: opacity 0.4s;
  }
  .lattice.lit::after { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .lattice::after { display: none; }
  }
  .hero img { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); }
  .hero h1 { font-size: var(--fs-name); font-weight: 700; letter-spacing: -0.02em; white-space: nowrap; }
  .role { color: var(--text-muted); margin-top: 2px; }
  .motto { color: var(--accent); font-size: var(--fs-sm); font-weight: 500; letter-spacing: 0.04em; margin-top: 4px; }
  .links { display: flex; gap: 18px; margin-left: auto; }
  .links a { color: var(--text-muted); display: inline-flex; }
  .links a:hover { color: var(--accent); }
  .links svg { width: 22px; height: 22px; }

  .prose p + p { margin-top: 12px; }

  .cards { display: grid; gap: 14px; }
  .card {
    display: grid; grid-template-columns: 1fr 240px; overflow: hidden;
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s, border-color 0.25s;
  }
  .card:hover {
    transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 10px 28px rgb(0 0 0 / 0.08);
  }
  .card > :global(.fig) { border-left: 1px solid var(--border); }
  .body { padding: 20px 24px; display: flex; flex-direction: column; }
  .card h3 { font-size: var(--fs-lg); font-weight: 600; letter-spacing: -0.01em; }
  /* Title underline draws in on hover. */
  .card h3 a {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .card h3 a:hover { background-size: 100% 1px; }
  .card .meta { display: flex; flex-wrap: wrap; gap: 2px 0; color: var(--text-muted); font-size: var(--fs-xs); margin-top: 4px; }
  .card .meta span + span::before { content: '·'; margin: 0 8px; opacity: 0.6; }
  .card p { font-size: var(--fs-base); margin-top: 10px; }
  .card .repo {
    display: flex; flex-wrap: wrap; align-items: center; gap: 4px 16px; margin-top: auto; padding-top: 14px;
    color: var(--text-muted); font-size: var(--fs-xs); font-variant-numeric: tabular-nums;
  }
  .repo a { display: inline-flex; align-items: center; gap: 6px; color: var(--text-strong); font-weight: 500; }
  .repo a:hover { color: var(--accent); }
  .repo svg { width: 14px; height: 14px; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
  @media (prefers-reduced-motion: reduce) { .card, .card h3 a { transition: none; } .card:hover { transform: none; } }

  .more { margin-top: 12px; font-size: var(--fs-sm); font-weight: 500; }


  /* Stack the figure under the text before the text column gets too narrow. */
  @media (max-width: 960px) {
    .card { grid-template-columns: 1fr; }
    .card > :global(.fig) { border-left: 0; border-top: 1px solid var(--border); }
  }
  @media (max-width: 720px) {
    .hero { flex-direction: column; align-items: flex-start; gap: 16px; }
    .links { margin-left: 0; }
    .lattice { inset: 0 0 0 40%; }
  }
</style>
