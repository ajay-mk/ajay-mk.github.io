---
import Base from '../layouts/Base.astro';
import { Icon } from 'astro-icon/components';
import Skills from '../components/Skills.astro';
import Rail from '../components/Rail.astro';
import Figure from '../components/Figure.astro';
import Goldstone from '../components/figures/Goldstone.astro';
import Tiles from '../components/figures/Tiles.astro';
import Chip from '../components/figures/Chip.astro';
import CvEntries from '../components/CvEntries.astro';
import HoverCard from '../components/HoverCard.astro';
import PublicationList from '../components/PublicationList.astro';
import { getCollection } from 'astro:content';
import { site } from '../config';
import type { Publication } from '../lib/publications';
import pubsData from '../data/publications.json';

const recent = (pubsData as Publication[]).slice(0, 3);
const cv = await getCollection('cv');
const items = (id: string) => cv.find((e) => e.id === id)?.data.items ?? [];

const work = [
  {
    name: 'SeQuant',
    href: 'https://github.com/ValeevGroup/SeQuant',
    repo: 'ValeevGroup/SeQuant',
    meta: 'C++ · symbolic tensor algebra · open source',
    desc: 'Derives many-body equations symbolically and evaluates them numerically. I implemented equation-of-motion, response, and unitary coupled-cluster methods, coupled-cluster density matrices, and a tool that estimates the cost of generated equations.',
    fig: { art: Goldstone, label: 'Goldstone diagram', caption: 'CCSD energy', note: 'derived' },
  },
  {
    name: 'Massively Parallel Quantum Chemistry (MPQC)',
    meta: 'C++ · MPI · TiledArray · MADNESS',
    desc: 'General-order coupled cluster in a distributed-memory electronic structure package built on the TiledArray tensor framework and the MADNESS parallel runtime: ground and excited states, linear-response properties, and electric-field perturbations.',
    fig: { art: Tiles, label: 'Tiled tensor', caption: '4 nodes', note: '4 × 4 tiles' },
  },
  {
    name: 'Tensor contractions on GPUs',
    meta: 'C++20 · CUDA · cuTENSOR',
    desc: 'An einsum layer over cuTENSOR and a SeQuant backend built on it, plus unified-memory device tiles for TiledArray.',
    fig: { art: Chip, label: 'Contraction on device', caption: 'CCSD energy', note: 'einsum' },
  },
];

// Repo details for the hover cards, fetched at build time. A failed fetch
// just means no card; it never fails the build.
async function repoInfo(slug: string) {
  const token = process.env.GITHUB_TOKEN;
  try {
    const res = await fetch(`https://api.github.com/repos/${slug}`, {
      headers: token ? { Authorization: `Bearer ${token}` } : {},
    });
    if (!res.ok) return null;
    const r = await res.json();
    return {
      description: r.description as string,
      language: r.language as string,
      stars: r.stargazers_count as number,
      pushed: r.pushed_at as string,
    };
  } catch {
    return null;
  }
}
// GitHub's language colours, for the dot in the card footer.
const langColor: Record<string, string> = { 'C++': '#f34b7d', Python: '#3572A5', Cuda: '#3A4E3A' };
const repos = Object.fromEntries(
  await Promise.all(work.filter((w) => w.repo).map(async (w) => [w.repo, await repoInfo(w.repo!)])),
);


const links = [
  { label: 'GitHub', href: site.socials.github, icon: 'simple-icons:github' },
  { label: 'Google Scholar', href: site.socials.scholar, icon: 'simple-icons:googlescholar' },
  { label: 'LinkedIn', href: site.socials.linkedin, icon: 'simple-icons:linkedin' },
];
---
<Base>
  <header class="hero">
    <img src="/avatar.jpg" alt={site.name} />
    <div>
      <h1>{site.name}</h1>
      <p class="role">{site.role}</p>
      <p class="motto mono">learn · build · scale</p>
    </div>
    <nav class="links">
      <a href={`mailto:${site.email}`} aria-label="Email" title="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m2 7 10 6 10-6" /></svg>
      </a>
      {links.map((l) => <a href={l.href} aria-label={l.label} title={l.label}><Icon name={l.icon} /></a>)}
    </nav>
  </header>

  <section class="section" id="about">
    <h2>About</h2>
    <div class="prose">
      <p>
        I am a PhD candidate in the <a href="https://valeevgroup.github.io" target="_blank" rel="noopener">Valeev
        Research Group</a> at <a href="https://www.vt.edu" target="_blank" rel="noopener">Virginia Tech</a>, working on
        coupled-cluster theory and the software that implements it. My current focus is unitary coupled cluster:
        a practical formulation based on a Bernoulli expansion, and benchmarks of it for ground and excited states.
      </p>
      <p>
        Most of this work lives in two C++ codes. <a href="https://github.com/ValeevGroup/SeQuant" target="_blank" rel="noopener"><code>SeQuant</code></a>{' '}
        derives many-body equations symbolically and evaluates them, and <code>MPQC</code> runs general-order
        coupled cluster on distributed memory. More recently, I have been moving these tensor contractions onto GPUs.
      </p>
      <p>
        Before Virginia Tech, I completed an integrated BS-MS at <a href="https://www.iisertvm.ac.in" target="_blank" rel="noopener">IISER
        Thiruvananthapuram</a>, where I developed empirical interaction potentials for layered materials.
      </p>
    </div>
  </section>

  <section class="section" id="work">
    <h2>Work</h2>
    <div class="cards">
      {work.map((w, i) => (
        <div class="card">
          <h3>
            {w.href ? (
              <HoverCard href={w.href} target="_blank">
                {w.name}
                {w.repo && repos[w.repo] && (
                  <span slot="card">
                    <span class="hc-head"><Icon name="simple-icons:github" />{w.repo}</span>
                    <span class="hc-body">{repos[w.repo].description}</span>
                    <span class="hc-foot">
                      <span><span class="dot" style={`background:${langColor[repos[w.repo].language] ?? 'var(--text-muted)'}`} />{repos[w.repo].language}</span>
                      <span>★ {repos[w.repo].stars}</span>
                      <span>updated <time datetime={repos[w.repo].pushed} data-relative>{repos[w.repo].pushed.slice(0, 10)}</time></span>
                    </span>
                  </span>
                )}
              </HoverCard>
            ) : w.name}
          </h3>
          <div class="meta mono">{w.meta}</div>
          <p>{w.desc}</p>
          {w.fig && (
            <Figure n={i + 1} label={w.fig.label} caption={w.fig.caption} note={w.fig.note}><w.fig.art /></Figure>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="section" id="experience">
    <h2>Experience</h2>
    <CvEntries items={[...items('experience'), ...items('teaching')]} />
  </section>

  <section class="section" id="publications">
    <h2>Publications</h2>
    <div>
      <PublicationList items={recent} previews />
      <p class="more"><a href="/publications">All publications →</a></p>
    </div>
  </section>

  <section class="section" id="education">
    <h2>Education</h2>
    <CvEntries items={items('education')} />
  </section>

  <section class="section" id="skills">
    <h2>Skills</h2>
    <Skills items={items('skills')} />
  </section>
  <Rail sections={[
    { id: 'about', label: 'About' }, { id: 'work', label: 'Work' }, { id: 'experience', label: 'Experience' },
    { id: 'publications', label: 'Publications' }, { id: 'education', label: 'Education' }, { id: 'skills', label: 'Skills' },
  ]} />
</Base>

<style>
  .hero { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; padding: 24px 0 32px; }
  .hero img { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border); }
  .hero h1 { font-size: 2rem; font-weight: 700; letter-spacing: -0.01em; white-space: nowrap; }
  .role { color: var(--text-muted); margin-top: 2px; }
  .motto { color: var(--accent); font-size: 0.8rem; margin-top: 4px; }
  .links { display: flex; gap: 18px; margin-left: auto; }
  .links a { color: var(--text-muted); display: inline-flex; }
  .links a:hover { color: var(--accent); }
  .links svg { width: 22px; height: 22px; }

  .prose p + p { margin-top: 12px; }

  .cards { display: grid; gap: 12px; }
  .card {
    display: grid; grid-template-columns: 1fr 220px; grid-template-rows: auto auto 1fr; column-gap: 20px; align-items: start;
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 18px 20px;
  }
  .card > :not(:global(.fig)) { grid-column: 1; }
  .card > :global(.fig) { grid-column: 2; grid-row: 1 / span 3; }
  .card h3 { font-size: 1.02rem; font-weight: 600; }
  .card .meta { color: var(--text-muted); font-size: 0.75rem; margin-top: 2px; }
  .card p { font-size: 0.93rem; margin-top: 8px; }

  .more { margin-top: 12px; font-size: 0.92rem; font-weight: 500; }


  @media (max-width: 720px) {
    .card { grid-template-columns: 1fr; }
    .card > :global(.fig) { grid-column: 1; grid-row: auto; margin-top: 14px; }
    .hero { flex-direction: column; align-items: flex-start; gap: 16px; }
    .links { margin-left: 0; }
  }
</style>
