---
import Base from '../layouts/Base.astro';
import CvEntries from '../components/CvEntries.astro';
import Skills from '../components/Skills.astro';
import { getCollection } from 'astro:content';

const cv = await getCollection('cv');
const get = (id: string) => cv.find((e) => e.id === id)?.data;
const order = ['education', 'experience', 'talks', 'posters', 'teaching', 'awards'];
const label = (s: string) => s[0].toUpperCase() + s.slice(1);
const skills = get('skills');
---
<Base title="CV">
  <div class="head">
    <h1>Curriculum vitae</h1>
    <a class="pdf" href="/cv/Ajay_CV.pdf">Download PDF ↗</a>
  </div>

  {order.map((id) => get(id) && (
    <section class="section">
      <h2>{label(get(id)!.section)}</h2>
      <CvEntries items={get(id)!.items} full />
    </section>
  ))}

  {skills && (
    <section class="section">
      <h2>Skills</h2>
      <Skills items={skills.items} />
    </section>
  )}
</Base>

<style>
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 16px 0 8px; }
  h1 { font-size: 1.8rem; font-weight: 700; }
  .pdf { font-weight: 500; white-space: nowrap; }
</style>
