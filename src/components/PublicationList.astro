---
import type { Publication } from '../lib/publications';
import { site } from '../config';
import HoverCard from './HoverCard.astro';
// `previews` shows the abstract in a hover card (used on the home page).
interface Props { items: Publication[]; previews?: boolean }
const { items, previews = false } = Astro.props;

// emphasize the owner's surname in author lists
const lastName = site.name.split(' ').slice(-1)[0];
---

<div>
  {items.map((p) => (
    <div class="entry">
      <div class="head">
        <HoverCard class="title" href={p.url ?? (p.doi ? `https://doi.org/${p.doi}` : undefined)}>
          {p.title}
          {previews && p.abstract && (
            <span slot="card">
              <span class="hc-head">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M9 13h6M9 17h6" /></svg>
                {p.venue}
              </span>
              <span class="hc-body"><span class="card-abstract">{p.abstract}</span></span>
              <span class="hc-foot"><span>{p.year}</span>{p.doi && <span>doi:{p.doi}</span>}</span>
            </span>
          )}
        </HoverCard>
        <div class="when">{p.year ?? '—'}</div>
      </div>
      <div class="sub">
        {p.authors.map((a, i) => (
          <>{i > 0 ? ', ' : ''}<span class={a.includes(lastName) ? 'me' : ''}>{a}</span></>
        ))}
      </div>
      {p.venue && <div class="sub venue">{p.venue}</div>}
    </div>
  ))}
</div>

<style>
  .me { color: var(--text-strong); font-weight: 500; }
  .venue { font-style: italic; }
  .card-abstract { display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; }
</style>
