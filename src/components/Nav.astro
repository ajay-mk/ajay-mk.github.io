---
import { site, nav } from '../config';
import ThemeToggle from './ThemeToggle.astro';
import { getCollection } from 'astro:content';
const { pathname } = Astro.url;
// Blog shows in the nav only once a published post exists.
const hasPosts = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;
const items = hasPosts ? [...nav, { href: '/blog', label: 'Blog' }] : nav;
---

<nav>
  <a class="brand" href="/">{site.name}</a>
  <ul>
    {items.map((item) => (
      <li><a class:list={['link', { active: pathname.startsWith(item.href) }]} href={item.href}>{item.label}</a></li>
    ))}
  </ul>
  <ThemeToggle />
</nav>

<style>
  nav { display: flex; align-items: center; gap: 24px; padding: 24px 0; }
  .brand { font-weight: 600; margin-right: auto; }
  ul { list-style: none; display: flex; gap: 24px; }
  .link { color: var(--text-muted); font-weight: 500; }
  .link:hover, .link.active { color: var(--text-strong); }
  .brand, .link { white-space: nowrap; }
  @media (max-width: 480px) { nav, ul { gap: 14px; } nav { font-size: var(--fs-sm); } }
</style>
