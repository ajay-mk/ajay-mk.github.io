---
interface Props { items: { role: string; details?: string[] }[] }
const { items } = Astro.props;
// One line icon per group, matched by position in cv.yaml.
const icons = [
  '<circle cx="12" cy="12" r="2"/><ellipse cx="12" cy="12" rx="10" ry="4"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>',
  '<path d="m8 6-6 6 6 6M16 6l6 6-6 6"/>',
  '<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/>',
  '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.4-.6-.6-2.4z"/>',
];
---
<div class="skills">
  {items.map((it, i) => (
    <div class="group">
      <h3>
        {icons[i] && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />}
        {it.role}
      </h3>
      <ul>{it.details?.map((d) => <li>{d}</li>)}</ul>
    </div>
  ))}
</div>

<style>
  .skills { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 32px; }
  h3 { display: flex; align-items: center; gap: 8px; font-size: 0.95rem; font-weight: 600; }
  svg { width: 18px; height: 18px; color: var(--accent); flex: none; }
  ul { margin: 6px 0 0 26px; color: var(--text-muted); font-size: 0.92rem; }
  li::marker { color: var(--accent); }
  @media (max-width: 720px) { .skills { grid-template-columns: 1fr; gap: 18px; } }
</style>
