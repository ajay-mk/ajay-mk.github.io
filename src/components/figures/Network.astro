---
// SeQuant end to end, top to bottom: the CCSD energy expression, the tensor network it derives, and the numbers it evaluates to.
const cx = 80;
const g = 44, t = 116, y = 84, r = 11;
// Four contracted legs between g and t; particle legs (a, b) in the accent colour.
const bonds = [{ bow: -16, p: true }, { bow: -6, p: true }, { bow: 6 }, { bow: 16 }];
// Evaluated molecular properties; shades stand in for values, none are shown.
const vals = [0.9, 0.35, 0.6, 0.15, 0.75, 0.3, 0.5, 0.2, 0.1, 0.65, 0.25, 0.8, 0.4, 0.55];
const cells = vals.map((v, k) => ({ x: 38 + (k % 7) * 12, y: 134 + Math.floor(k / 7) * 12, v, k }));
---
<svg viewBox="0 0 160 160" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">

  <text x={cx} y="22" class="eq s" style="--d:0s">E<tspan class="up"> = ⟨</tspan>Φ<tspan class="up">|</tspan>e<tspan dy="-6" class="sup">−T</tspan><tspan dy="6"> H e</tspan><tspan dy="-6" class="sup">T</tspan><tspan dy="6" class="up">|</tspan>Φ<tspan class="up">⟩</tspan></text>

  <line class="fl s" style="--d:0.35s" x1={cx} y1="32" x2={cx} y2="62" stroke-dasharray="3 3" />
  <text class="stage s" style="--d:0.35s" x={cx + 8} y="50">derive</text>
  {bonds.map((b, i) => (
    <path class="fl bond s" style={`--d:${0.9 + i * 0.08}s`} d={`M${g} ${y} Q ${(g + t) / 2} ${y + 2 * b.bow}, ${t} ${y}`} stroke={b.p ? 'var(--accent)' : 'currentColor'} stroke-dasharray="3 3" />
  ))}
  <g class="s pop" style="--d:0.55s"><circle cx={g} cy={y} r={r} class="nn" /><text x={g} y={y + 5} class="nt">g</text></g>
  <g class="s pop" style="--d:0.7s"><circle cx={t} cy={y} r={r} class="nn" /><text x={t} y={y + 5} class="nt">t</text></g>
  <line class="fl s" style="--d:1.35s" x1={cx} y1="104" x2={cx} y2="128" stroke-dasharray="3 3" />
  <text class="stage s" style="--d:1.35s" x={cx + 8} y="119">evaluate</text>

  {cells.map((c) => (
    <rect class="cl" style={`--d:${1.55 + c.k * 0.06}s; --v:${c.v}`} x={c.x} y={c.y} width="11" height="11" rx="1.5" stroke-width="0.6" />
  ))}
</svg>

<style>
  .eq { font: italic 15px var(--font-math); fill: var(--text-strong); stroke: none; text-anchor: middle; }
  .sup { font-size: 10px; }
  .up { font-style: normal; }
  .stage { font: 500 7.5px var(--font-sans); fill: currentColor; stroke: none; letter-spacing: 0.04em; }
  .nn { fill: var(--bg); }
  .cl { fill: var(--accent); fill-opacity: var(--v); stroke: var(--border); }
  .nt { font: italic 15px var(--font-math); fill: var(--text-strong); stroke: none; text-anchor: middle; }
  .pop { transform-box: fill-box; transform-origin: center; }
  /* The story, while the card has .play (set on scroll-in and hover): equation, then the network it
     derives, then the numbers it evaluates to. Everything rests fully drawn. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.play) .s { animation: nw-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) var(--d) backwards; }
    :global(.play) .pop { animation-name: nw-pop; }
    :global(.play) .bond { animation: nw-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) var(--d) backwards, nw-flow 0.6s linear var(--d) 2; }
    :global(.play) .cl { animation: nw-fill 0.4s ease-out var(--d) backwards; }
  }
  @keyframes nw-in { from { opacity: 0; } }
  @keyframes nw-pop { from { opacity: 0; transform: scale(0.6); } }
  @keyframes nw-flow { to { stroke-dashoffset: -12; } }
  @keyframes nw-fill { from { fill-opacity: 0; } }
</style>
