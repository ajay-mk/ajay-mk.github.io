---
// SeQuant end to end: the CCSD energy expression, its derived tensor network, and the energy converging numerically.
const cx = 128;
const g = 92, t = 164, y = 72, r = 11;
// Four contracted legs between g and t; particle legs (a, b) in the accent colour.
const bonds = [{ bow: -16, p: true }, { bow: -6, p: true }, { bow: 6 }, { bow: 16 }];
// Iterations settling onto the converged energy (dashed); illustrative, no values.
const its = [0, 1, 2, 3, 4, 5, 6].map((k) => ({ x: 92 + k * 12, y: 140 - 22 * Math.exp(-0.75 * k), k }));
---
<svg viewBox="0 0 220 150" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
  <text x="4" y="25" class="st">equation</text>
  <text x="4" y="75" class="st">derived</text>
  <text x="4" y="133" class="st">numbers</text>

  <text x={cx} y="25" class="eq">E = ⟨Φ|e<tspan dy="-5" class="sup">−T</tspan><tspan dy="5"> H e</tspan><tspan dy="-5" class="sup">T</tspan><tspan dy="5">|Φ⟩</tspan></text>

  <line class="fl" x1={cx} y1="34" x2={cx} y2="46" stroke-dasharray="3 3" />
  {bonds.map((b) => (
    <path class="fl" d={`M${g} ${y} Q ${(g + t) / 2} ${y + 2 * b.bow}, ${t} ${y}`} stroke={b.p ? 'var(--accent)' : 'currentColor'} stroke-dasharray="3 3" />
  ))}
  <circle cx={g} cy={y} r={r} class="nn" />
  <circle cx={t} cy={y} r={r} class="nn" />
  <text x={g} y={y + 4} class="nt">g</text>
  <text x={t} y={y + 4} class="nt">t</text>
  <line class="fl" x1={cx} y1="98" x2={cx} y2="110" stroke-dasharray="3 3" />

  <line x1="88" y1="140" x2="168" y2="140" stroke-width="0.8" stroke-dasharray="2 3" />
  <polyline points={its.map((p) => `${p.x},${p.y}`).join(' ')} stroke="var(--accent)" />
  {its.map((p) => <circle class="it" style={`--k:${p.k}`} cx={p.x} cy={p.y} r="2" fill="var(--accent)" stroke="none" />)}
  <text x="174" y="143" class="nt">E</text>
</svg>

<style>
  .st { font: 8px var(--font-mono); fill: currentColor; stroke: none; letter-spacing: 0.06em; }
  .eq { font: italic 12px var(--font-sans); fill: var(--text-strong); stroke: none; text-anchor: middle; }
  .sup { font-size: 8px; }
  .nn { fill: var(--bg); }
  .nt { font: italic 12px var(--font-sans); fill: var(--text-strong); stroke: none; text-anchor: middle; }
  :global(.card:hover) .fl { animation: nw-flow 1s linear infinite; }
  :global(.card:hover) .it { animation: nw-tick 2s steps(1) infinite; animation-delay: calc(var(--k) * 120ms); }
  @keyframes nw-flow { to { stroke-dashoffset: -12; } }
  @keyframes nw-tick { 0% { fill-opacity: 0; } 40%, 100% { fill-opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { :global(.card:hover) :is(.fl, .it) { animation: none; } }
</style>
