---
// Katal: one einsum call is planned once, the plan is cached, and the GPU runs it.
// ponytail: centred by measuring a 0.6em monospace advance (JetBrains Mono).
const call = 'einsum("abij,ijab->", t, g)';
const fs = 9.5, x0 = 110 - (call.length * fs * 0.6) / 2;
const cols = 8;
const tiles = Array.from({ length: cols * 3 }, (_, k) => ({ x: 63 + (k % cols) * 12, y: 78 + Math.floor(k / cols) * 12, c: k % cols, r: Math.floor(k / cols) }));
const steps = [0, 1, 2];
---
<svg class="kt" viewBox="26 6 168 112" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" aria-hidden="true">
  <text x={x0} y="20" class="code s" style="--d:0s">einsum("<tspan class="ix">abij</tspan>,<tspan class="ix">ijab</tspan>-&gt;", t, g)</text>
  <line class="s" style="--d:0.25s" x1="110" y1="26" x2="110" y2="37" stroke-dasharray="2 3" />
  <rect class="s plan" style="--d:0.3s" x="58" y="37" width="104" height="24" rx="4" />
  <text class="lbl s" style="--d:0.3s" x="66" y="52">plan</text>
  {steps.map((s) => <rect class="step" style={`--d:${0.55 + s * 0.25}s`} x={94 + s * 22} y="44" width="18" height="10" rx="2" />)}
  <line class="s" style="--d:0.3s" x1="110" y1="61" x2="110" y2="74" stroke-dasharray="2 3" />
  {tiles.map((t, k) => <rect class:list={['tile', { last: k === tiles.length - 1 }]} style={`--c:${t.c}; --r:${t.r}`} x={t.x} y={t.y} width="9" height="9" rx="1.5" stroke-width="0.6" />)}
</svg>

<script>
  // After the first full run the plan is cached: later replays skip the planning steps.
  for (const svg of document.querySelectorAll<SVGElement>('.kt')) {
    svg.addEventListener('animationend', (e) => {
      if ((e.target as Element).classList.contains('last')) svg.classList.add('cached');
    });
  }
</script>

<style>
  .kt { --run: 1.35s; }
  .kt.cached { --run: 0.35s; }
  .code { font: 500 9.5px var(--font-mono); fill: var(--text-strong); stroke: none; }
  .ix { fill: var(--accent); }
  .lbl { font: 500 8px var(--font-sans); fill: currentColor; stroke: none; letter-spacing: 0.06em; text-transform: uppercase; }
  .plan { stroke: var(--accent); }
  .step { fill: var(--accent); fill-opacity: 0.7; stroke: none; }
  .tile { fill: var(--accent); fill-opacity: 0.15; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.play) .s { animation: kt-in 0.4s ease-out var(--d) backwards; }
    :global(.play) .step { animation: kt-fill 0.3s ease-out var(--d) backwards; }
    :global(.play) .cached .step { animation: none; }
    :global(.play) .tile { animation: kt-run 0.6s ease-in-out calc(var(--run) + var(--c) * 60ms + var(--r) * 25ms); }
  }
  @keyframes kt-in { from { opacity: 0; } }
  @keyframes kt-fill { from { fill-opacity: 0; } }
  @keyframes kt-run { 40% { fill-opacity: 0.85; } }
</style>
