---
// Figure panel for a work card: a small label, then the drawing.
interface Props { label: string }
const { label } = Astro.props;
---
<figure class="fig">
  <div class="label">{label}</div>
  <div class="art"><slot /></div>
</figure>

<style>
  .fig { display: flex; flex-direction: column; gap: 8px; padding: 14px 16px; background: var(--bg); color: var(--text-muted); }
  .label { text-align: center; font-size: var(--fs-tiny); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
  .art { flex: 1; display: grid; place-items: center; min-height: 130px; }
  .art :global(svg) { width: 100%; max-height: 220px; overflow: visible; }
</style>
